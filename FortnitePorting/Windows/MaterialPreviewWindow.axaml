<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:ext="clr-namespace:FortnitePorting.Extensions;assembly=FortnitePorting"
        xmlns:windowModels="clr-namespace:FortnitePorting.WindowModels"
        xmlns:windows="clr-namespace:FortnitePorting.Windows"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:objects="clr-namespace:CUE4Parse.UE4.Objects.UObject;assembly=CUE4Parse"
        xmlns:controls="clr-namespace:FortnitePorting.Controls"
        xmlns:material="clr-namespace:FortnitePorting.Models.Nodes.Material"
        xmlns:nodes="clr-namespace:FortnitePorting.Models.Nodes"
        x:Class="FortnitePorting.Windows.MaterialPreviewWindow"
        x:DataType="windowModels:MaterialPreviewWindowModel"
        Width="1280" Height="720" RequestedThemeVariant="Dark" Background="{DynamicResource WindowBackgroundBrush}"  
        TransparencyLevelHint="{Binding Settings.Application.TransparencyHints}"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" FontFamily="{Binding ViewerFont, Source={x:Static nodes:MaterialViewerSettings.Instance}}"
        WindowStartupLocation="CenterScreen" ClosingBehavior="OwnerAndChildWindows" ExtendClientAreaTitleBarHeightHint="35"
        Icon="/Assets/LogoRebrand.ico"
        Title="Material Viewer">
    <Window.Resources>
        <GeometryDrawing x:Key="SmallGridGeometry"
                         Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z"
                         Brush="#343434" />

        <GeometryDrawing x:Key="LargeGridGeometry"
                         Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z"
                         Brush="#161616" />

        <DrawingBrush x:Key="SmallGridLinesDrawingBrush"
                      TileMode="Tile"
                      DestinationRect="0 0 62 62"
                      Transform="{Binding ViewportTransform, ElementName=Editor}"
                      Drawing="{StaticResource SmallGridGeometry}" />

        <DrawingBrush x:Key="LargeGridLinesDrawingBrush"
                      TileMode="Tile"
                      DestinationRect="0 0 248 248"
                      Transform="{Binding ViewportTransform, ElementName=Editor}"
                      Drawing="{StaticResource LargeGridGeometry}" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.ToolbarIcon">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ToolbarIcon avalonia|MaterialIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="35, *" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:WindowTitleBar Grid.Row="0" Title="Material Viewer"/>
        
        <Grid Grid.Row="1" RowDefinitions="Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="{ext:Space 0, 0, 0, 1}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" Margin="{ext:Space 0.5, 0}">
                    <Button Classes="ToolbarIcon" Tapped="OnSort" ToolTip.Tip="Sort layout: nudge overlapping nodes apart (selection or whole graph)">
                        <avalonia:MaterialIcon Kind="AutoFix"/>
                    </Button>
                    <Button Classes="ToolbarIcon" Command="{Binding CleanUpGraphCommand}" ToolTip.Tip="Clean up: remove nodes that don't reach the output">
                        <avalonia:MaterialIcon Kind="Broom"/>
                    </Button>
                    <Border Width="1" Background="{DynamicResource ContentBorderBorderBrush}" Margin="4 5"/>
                    <Button Classes="ToolbarIcon" Click="OnCenterView" ToolTip.Tip="Center view (Home)">
                        <avalonia:MaterialIcon Kind="ImageFilterCenterFocus"/>
                    </Button>
                    <Button Classes="ToolbarIcon" Click="OnFrameSelection" ToolTip.Tip="Frame the selection (F)">
                        <avalonia:MaterialIcon Kind="CropFree"/>
                    </Button>
                    <Border Width="1" Background="{DynamicResource ContentBorderBorderBrush}" Margin="4 5"/>
                    <Button Classes="ToolbarIcon" Click="OnHideSelected" ToolTip.Tip="Hide selected nodes (H)">
                        <avalonia:MaterialIcon Kind="EyeOffOutline"/>
                    </Button>
                    <Button Classes="ToolbarIcon" Click="OnUnhide" ToolTip.Tip="Unhide (U) — selection, or all if nothing selected">
                        <avalonia:MaterialIcon Kind="EyeOutline"/>
                    </Button>
                </StackPanel>

                <ui:TabView Grid.Column="1" IsAddTabButtonVisible="False" SelectionChanged="OnTabSelectionChanged" TabCloseRequested="OnTabClosed"
                            TabItems="{Binding Trees}" TabWidthMode="Compact"
                            SelectedItem="{Binding SelectedTree, Mode=TwoWay}">
                    <ui:TabView.TabItemTemplate>
                        <DataTemplate x:DataType="material:MaterialNodeTree">
                            <TextBlock Text="{Binding TreeName}"/>
                        </DataTemplate>
                    </ui:TabView.TabItemTemplate>
                    <ui:TabView.Styles>
                        <Style Selector="Border#RightBottomBorderLine">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        <Style Selector="Border#LeftRightBottomBorderLine">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                    </ui:TabView.Styles>
                </ui:TabView>

                <Button Grid.Column="2" Classes="ToolbarIcon" VerticalAlignment="Center" Margin="{ext:Space 0, 0, 0.5, 0}" ToolTip.Tip="Options">
                    <avalonia:MaterialIcon Kind="Cog"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="5" MinWidth="270" Margin="4">
                                <TextBlock Text="Options" Classes="BodyStrongTextBlockStyle"/>

                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Font" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                              ItemsSource="{Binding Fonts, Source={x:Static nodes:MaterialViewerSettings.Instance}}"
                                              SelectedItem="{Binding SelectedFont, Mode=TwoWay, Source={x:Static nodes:MaterialViewerSettings.Instance}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="nodes:FontOption">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2" Classes="ToolbarIcon" ToolTip.Tip="Reset to default"
                                            Command="{Binding ResetFontCommand, Source={x:Static nodes:MaterialViewerSettings.Instance}}">
                                        <avalonia:MaterialIcon Kind="Restore"/>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Dim unrelated on select" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding DimOnSelect, Mode=TwoWay, Source={x:Static nodes:MaterialViewerSettings.Instance}}"/>
                                    <Button Grid.Column="2" Classes="ToolbarIcon" ToolTip.Tip="Reset to default"
                                            Command="{Binding ResetDimOnSelectCommand, Source={x:Static nodes:MaterialViewerSettings.Instance}}">
                                        <avalonia:MaterialIcon Kind="Restore"/>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Straight connections" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding StraightConnections, Mode=TwoWay, Source={x:Static nodes:MaterialViewerSettings.Instance}}"/>
                                    <Button Grid.Column="2" Classes="ToolbarIcon" ToolTip.Tip="Reset to default"
                                            Command="{Binding ResetStraightConnectionsCommand, Source={x:Static nodes:MaterialViewerSettings.Instance}}">
                                        <avalonia:MaterialIcon Kind="Restore"/>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Node colours" Classes="BodyStrongTextBlockStyle" Margin="0 3 0 0"/>
                                <ItemsControl ItemsSource="{Binding HeaderColors, Source={x:Static nodes:MaterialViewerSettings.Instance}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="nodes:HeaderColorOption">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0 1">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           Text="{Binding Category, Converter={StaticResource UnrealCaseString}}"/>
                                                <ColorPicker Grid.Column="1" VerticalAlignment="Center" Color="{Binding Color, Mode=TwoWay}"/>
                                                <Button Grid.Column="2" Classes="ToolbarIcon" ToolTip.Tip="Reset to default"
                                                        Command="{Binding ResetCommand}">
                                                    <avalonia:MaterialIcon Kind="Restore"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            
            
            <Border Grid.Row="1" Background="{DynamicResource ContentBorderBackgroundBrush}" CornerRadius="0"
                    BorderThickness="0 2 0 0" BorderBrush="{DynamicResource ContentBorderBorderBrush}">
                <Grid x:Name="MainSplitGrid" Margin="{ext:Space 1}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    
                    <Grid Grid.Column="2" x:Name="SearchPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{ext:Space 1}"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Text="{Binding SelectedTree.SearchFilter}" Watermark="Search..."/>

                        <ListBox Grid.Row="2" ItemsSource="{Binding SelectedTree.Nodes}"
                                 SelectedItem="{Binding SelectedTree.SelectedNode, Mode=TwoWay}"
                                 SelectionMode="Single" SelectionChanged="OnSearchSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{ext:Space 0, 1}">
                                        <TextBlock Text="{Binding ExpressionDisplayName, Converter={StaticResource UnrealCaseString}}" Classes="CaptionTextBlockStyle"/>
                                        <TextBlock Text="{Binding Label}" Classes="CaptionTextBlockStyle TextFillColorSecondaryBrush"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    
                    <Grid Grid.Column="1">
                        <GridSplitter Background="Transparent" HorizontalAlignment="Stretch"/>
                        <Button x:Name="TogglePanelButton" Click="OnTogglePanel" Content="&gt;"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Width="18" Height="44" Padding="0" FontSize="12"
                                ToolTip.Tip="Hide / show the search panel"/>
                    </Grid>
                    
                    
                    <controls:ContentCard Grid.Column="0" ClipToBounds="True">
                        <Grid>
                            <Grid Background="#9F262626" ZIndex="-2"/>
                            
                            <nodify:NodifyEditor x:Name="Editor" CornerRadius="4"
                                                 DataContext="{Binding SelectedTree}"
                                                 ItemsSource="{Binding GraphNodes}"
                                                 Connections="{Binding Connections}"
                                                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                                 CanSelectMultipleItems="True" Background="Transparent"
                                                 ViewportZoom="1" MaxViewportZoom="3"
                                                 KeyDown="OnEditorKeyDown" PointerPressed="OnEditorPointerPressed">
                                <nodify:NodifyEditor.ItemTemplate>
                                    <DataTemplate>
                                       <ContentControl Content="{Binding}">
                                           <ContentControl.DataTemplates>
                                               
                                               <DataTemplate DataType="nodes:NodeComment">
                                                   <nodify:GroupingNode Header="{Binding DisplayName}"
                                                                        Width="{Binding Size.Width}"
                                                                        Height="{Binding Size.Height}"
                                                                        HeaderBrush="{Binding HeaderBrush}"
                                                                        Background="{Binding BackgroundBrush}"
                                                                        BorderBrush="{Binding CommentBorderBrush}"
                                                                        BorderThickness="1.5">
                                                       <nodify:GroupingNode.HeaderTemplate>
                                                           <DataTemplate x:DataType="x:String">
                                                               <TextBlock Text="{Binding}" Classes="BodyStrongTextBlockStyle" FontFamily="{Binding ViewerFont, Source={x:Static nodes:MaterialViewerSettings.Instance}}">
                                                                   <TextBlock.Effect>
                                                                       <DropShadowEffect Color="Black" Opacity="0.5" OffsetX="1" OffsetY="1" BlurRadius="0"/>
                                                                   </TextBlock.Effect>
                                                               </TextBlock>
                                                           </DataTemplate>
                                                       </nodify:GroupingNode.HeaderTemplate>
                                                   </nodify:GroupingNode>
                                               </DataTemplate>
                                               
                                               <DataTemplate DataType="material:MaterialNode">
                                                   <nodify:Node Header="{Binding DisplayName}" 
                                                                Input="{Binding Inputs}"
                                                                Output="{Binding Outputs}"
                                                                Content="{Binding Content}"
                                                                HeaderBrush="{Binding HeaderBrush}" 
                                                                BorderBrush="{Binding BorderBrush}"
                                                                Background="{Binding BackgroundBrush}"
                                                                BorderThickness="2" Footer="{Binding FooterContent}"
                                                                ContentBrush="Transparent" PointerPressed="OnNodePressed">
                                                       <nodify:Node.Effect>
                                                           <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="14" OffsetX="0" OffsetY="4"/>
                                                       </nodify:Node.Effect>
                                                       <nodify:Node.Styles>
                                                           <Style Selector="Border#PART_Header">
                                                               <Setter Property="CornerRadius" Value="2 2 0 0"/>
                                                               <Setter Property="Padding" Value="{ext:Space 1, 0.5, 1, 0.5}"/>
                                                           </Style>
                                                       </nodify:Node.Styles>
                                                       <nodify:Node.HeaderTemplate>
                                                           <DataTemplate x:DataType="x:String">
                                                               <TextBlock Text="{Binding}" Classes="BodyStrongTextBlockStyle" FontFamily="{Binding ViewerFont, Source={x:Static nodes:MaterialViewerSettings.Instance}}">
                                                                   <TextBlock.Effect>
                                                                       <DropShadowEffect Color="Black" Opacity="0.5" OffsetX="1" OffsetY="1" BlurRadius="0"/>
                                                                   </TextBlock.Effect>
                                                               </TextBlock>
                                                           </DataTemplate>
                                                       </nodify:Node.HeaderTemplate>
                                                       <nodify:Node.InputConnectorTemplate>
                                                           <DataTemplate DataType="{x:Type nodes:NodeSocket}">
                                                               <nodify:NodeInput Header="{Binding Name}"
                                                                                 Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                                                 IsConnected="True" Background="Transparent" BorderBrush="{Binding SocketBrush}">
                                                                   <nodify:NodeInput.HeaderTemplate>
                                                                       <DataTemplate DataType="x:String">
                                                                           <TextBlock Text="{Binding}" FontSize="12">
                                                                               <TextBlock.Effect>
                                                                                   <DropShadowEffect Color="Black" Opacity="0.5" OffsetX="1" OffsetY="1" BlurRadius="0"/>
                                                                               </TextBlock.Effect>
                                                                           </TextBlock>
                                                                       </DataTemplate>
                                                                   </nodify:NodeInput.HeaderTemplate>
                                                               </nodify:NodeInput>
                                                           </DataTemplate>
                                                       </nodify:Node.InputConnectorTemplate>

                                                       <nodify:Node.OutputConnectorTemplate>
                                                           <DataTemplate DataType="{x:Type nodes:NodeSocket}">
                                                               <nodify:NodeOutput Header="{Binding Name}"
                                                                                  Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                                                  IsConnected="True" Background="Transparent" BorderBrush="{Binding SocketBrush}">
                                                                   <nodify:NodeOutput.HeaderTemplate>
                                                                       <DataTemplate DataType="x:String">
                                                                           <TextBlock Text="{Binding}" FontSize="12">
                                                                               <TextBlock.Effect>
                                                                                   <DropShadowEffect Color="Black" Opacity="0.5" OffsetX="1" OffsetY="1" BlurRadius="0"/>
                                                                               </TextBlock.Effect>
                                                                           </TextBlock>
                                                                       </DataTemplate>
                                                                   </nodify:NodeOutput.HeaderTemplate>
                                                               </nodify:NodeOutput>
                                                           </DataTemplate>
                                                       </nodify:Node.OutputConnectorTemplate>
                                                   </nodify:Node>
                                               </DataTemplate>
                                           </ContentControl.DataTemplates>
                                       </ContentControl>
                                    </DataTemplate>
                                </nodify:NodifyEditor.ItemTemplate>
                                <nodify:NodifyEditor.ConnectionTemplate>
                                    <DataTemplate DataType="{x:Type nodes:NodeConnection}">
                                        <nodify:LineConnection Source="{Binding From.Anchor}"
                                                               Target="{Binding To.Anchor}"
                                                               ArrowEnds="None"
                                                               Spacing="{Binding ConnectionSpacing, Source={x:Static nodes:MaterialViewerSettings.Instance}}"
                                                               SourceOffsetMode="None" TargetOffsetMode="None"
                                                               Fill="{Binding StrokeBrush}" Stroke="{Binding StrokeBrush}" Opacity="{Binding ConnectionOpacity}"/>
                                    </DataTemplate>
                                </nodify:NodifyEditor.ConnectionTemplate>
                                <nodify:NodifyEditor.ItemContainerTheme>
                                    <ControlTheme TargetType="{x:Type nodify:ItemContainer}" x:DataType="nodes:BaseNode">
                                        <Setter Property="Location"
                                                Value="{Binding Location, Mode=TwoWay}" />
                                        <Setter Property="IsSelectable"
                                                Value="True" />
                                        <Setter Property="IsSelected"
                                                Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="Opacity"
                                                Value="{Binding NodeOpacity}" />
                                        <Setter Property="IsHitTestVisible"
                                                Value="{Binding Interactable}" />
                                        <Setter Property="ZIndex"
                                                Value="{Binding CanvasZIndex}" />
                                    </ControlTheme>
                                </nodify:NodifyEditor.ItemContainerTheme>
                            </nodify:NodifyEditor>
                            
                            <Grid ZIndex="-3"
                                  Background="{StaticResource SmallGridLinesDrawingBrush}"/>
                            <Grid ZIndex="-2"
                                  Background="{StaticResource LargeGridLinesDrawingBrush}"/>

                            <!-- Constant-size place-marker overlay (Shift+RMB to drop, click a pin to remove).
                                 Null background so empty areas pass clicks through to the editor. -->
                            <Canvas x:Name="PinOverlay" Background="{x:Null}" ClipToBounds="True"/>
                        </Grid>
                    </controls:ContentCard>
                    
                    
                    <controls:ContentCard Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{ext:Space 0, 1, 1, 0}"
                              DataContext="{Binding SelectedTree.SelectedNode}" 
                              IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid Margin="{ext:Space 2}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{ext:Space 1}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding ExpressionDisplayName, Converter={StaticResource UnrealCaseString}}" 
                                       Classes="BodyStrongTextBlockStyle" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{ext:Space 0, 0.5}" ColumnDefinitions="*,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                       Classes="CaptionTextBlockStyle" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        
                                            <ContentControl Grid.Column="1" Content="{Binding Value}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="False">
                                                <ContentControl.DataTemplates>
                                                    <DataTemplate DataType="objects:FPackageIndex">
                                                        <Button Content="{avalonia:MaterialIconExt Folder}" ToolTip.Tip="Navigate To"
                                                                Command="{Binding $parent[windows:MaterialPreviewWindow].WindowModel.NavigateTo}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                    
                                                    <DataTemplate DataType="objects:FSoftObjectPath">
                                                        <Button Content="{avalonia:MaterialIconExt Folder}" ToolTip.Tip="Navigate To"
                                                                Command="{Binding $parent[windows:MaterialPreviewWindow].WindowModel.NavigateToPath}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                    
                                                    <DataTemplate DataType="objects:FName">
                                                        <TextBlock Text="{Binding Text}" Classes="CaptionTextBlockStyle"/>
                                                    </DataTemplate>
                                                    
                                                    <DataTemplate DataType="sys:Single">
                                                        <ui:NumberBox Value="{Binding }"/>
                                                    </DataTemplate>
                                                    
                                                    <DataTemplate DataType="nodes:JsonPropertyContainer">
                                                        <Button Command="{Binding OpenPropertiesCommand}">
                                                            <avalonia:MaterialIcon Kind="CodeJson"/>
                                                        </Button>
                                                    </DataTemplate>
                                                    
                                                    <DataTemplate DataType="sys:Object">
                                                        <TextBlock Text="{Binding}" Classes="CaptionTextBlockStyle"/>
                                                    </DataTemplate>
                                                </ContentControl.DataTemplates>
                                            </ContentControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                       
                    </controls:ContentCard>
                    
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
</Window>
